{
  "manifest_version": 3,
  "name": "מוריד הסרטונים",
  "description": "מוסיף כפתור הורדה לסרטונים ביוטיוב, שפותח את התוכנה מוריד הסרטונים ומוריד כ-MP4 או MP3.",
  "version": "1.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
